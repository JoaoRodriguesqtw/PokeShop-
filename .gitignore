# Dependências (Nunca envie a pasta node_modules)
node_modules/
/jspm_packages/

# Produção / Builds (Arquivos gerados automaticamente)
dist/
build/
out/
.next/

# Logs de erro e debug
*.log
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variáveis de ambiente e segredos (MUITO IMPORTANTE)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# Arquivos e pastas do sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# IDEs e Editores de código (Opcional, mas recomendado)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Testes e Cobertura de código
coverage/
.nyc_output/

# Logs do Cypress ou outras ferramentas de teste
cypress/videos/
cypress/screenshots/

# Cache de ferramentas de build (Vite, Next, Turbo, etc.)
.eslintcache
.parcel-cache
.turbo/
.vite/
.rts2_cache*
